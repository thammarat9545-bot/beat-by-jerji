# Firebase Configuration
# สามารถนำค่าจาก Firebase Console > Project Settings > General > Your Apps (Web App) มาใส่ที่นี่
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# รายชื่ออีเมลที่มีสิทธิ์ Admin เจ้าของร้าน (คั่นด้วยจุลภาค)
NEXT_PUBLIC_ADMIN_EMAILS=admin@beatbyjerji.com,jerji.beats@studio.com

# ข้อมูลบัญชีพร้อมเพย์สำหรับรับเงิน (เบอร์โทร 10 หลัก หรือ เลขประจำตัวประชาชน 13 หลัก)
NEXT_PUBLIC_PROMPTPAY_ID=0927236792
NEXT_PUBLIC_PROMPTPAY_NAME=ธรรมรัตน์  ไพลสาลี
